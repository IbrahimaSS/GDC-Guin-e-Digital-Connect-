# Copier ce fichier en .env puis adapter les valeurs.

# Serveur
PORT=4000
# Adresse du frontend autorisée à appeler l'API (CORS)
CORS_ORIGIN=http://localhost:3000

# Base de données (npm run db démarre une base locale sur le port 5433)
DATABASE_URL=postgresql://gdc:gdc@localhost:5433/gdc?schema=public

# Jetons de connexion : remplacer par de longues chaînes aléatoires en production
JWT_ACCESS_SECRET=changer-moi-acces
JWT_REFRESH_SECRET=changer-moi-rafraichissement
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Codes SMS : durée de validité (minutes) et nombre d'essais
OTP_TTL_MINUTES=5
OTP_MAX_ESSAIS=5

# Envoi des SMS / WhatsApp : "console" (affichage dans le terminal) en développement
SMS_DRIVER=console

# Connexion Google : identifiant OAuth (le même que NEXT_PUBLIC_GOOGLE_CLIENT_ID côté frontend)
GOOGLE_CLIENT_ID=
