# Copier ce fichier en .env.local puis renseigner les valeurs.

# Adresse de l'API GDC (dossier backend/). Laisser vide pour le mode démonstration :
# le site fonctionne alors seul, avec les données fictives de src/lib/data.ts.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Connexion avec Google (bouton « Continuer avec Google » sur la page de connexion).
# Créer un identifiant OAuth « Application Web » sur https://console.cloud.google.com/apis/credentials
# et ajouter http://localhost:3000 (et le domaine de production) aux « Origines JavaScript autorisées ».
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
